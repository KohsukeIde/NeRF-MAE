#!/usr/bin/env bash
#PBS -q rt_HG
#PBS -l select=1
#PBS -l walltime=02:00:00
#PBS -P gag51404
#PBS -j oe

set -euo pipefail

cd "${PBS_O_WORKDIR:?PBS_O_WORKDIR is not set}"

ROOT_DIR="${ROOT_DIR:-${PBS_O_WORKDIR}}"
PROBE_ENV_PREFIX="${PROBE_ENV_PREFIX:-${ROOT_DIR}/.venv-abci3}"
ABCI3_CUDA_MODULE="${ABCI3_CUDA_MODULE:-cuda/11.8/11.8.0}"
GT_BOXES_DIR="${GT_BOXES_DIR:-${ROOT_DIR}/dataset/_downloads/front3d_rpn_extract/front3d_rpn_data/obb}"
OUTPUT_DIR="${OUTPUT_DIR:-${ROOT_DIR}/results/shortcut_probe_artifacts/proposal_quality}"

source /etc/profile.d/modules.sh
module load "${ABCI3_CUDA_MODULE}"

export PYTHONPATH="${ROOT_DIR}"
export PATH="${PROBE_ENV_PREFIX}/bin:${PATH}"
export LD_LIBRARY_PATH="${PROBE_ENV_PREFIX}/lib/python3.11/site-packages/torch/lib:${LD_LIBRARY_PATH:-}"
export CUDA_VISIBLE_DEVICES="${CUDA_VISIBLE_DEVICES:-0}"

mkdir -p "${OUTPUT_DIR}"

"${PROBE_ENV_PREFIX}/bin/python" "${ROOT_DIR}/nerf_rpn/tools/summarize_proposal_quality.py" \
  --gt-boxes-dir "${GT_BOXES_DIR}" \
  --device cuda:0 \
  --output-json "${OUTPUT_DIR}/e100_dmae_coord_controls.json" \
  --output-md "${OUTPUT_DIR}/e100_dmae_coord_controls.md" \
  --diagnostic "baseline_no_pos=${ROOT_DIR}/output/nerf_rpn/results/nerfmae_baseline_no_pos_p1.0_e100_seed1_abci3diag_opt1n8g_det0_epoch100_sched_epoch_seed1_fcos1000_eval" \
  --diagnostic "alpha_coord_jitter=${ROOT_DIR}/output/nerf_rpn/results/nerfmae_alpha_target_only_coord_jitter_p1.0_e100_seed1_abci3diag_opt1n8g_det0_epoch100_sched_epoch_seed1_fcos1000_eval" \
  --diagnostic "cosine_coord_jitter=${ROOT_DIR}/output/nerf_rpn/results/nerfmae_cosine_coord_jitter_p1.0_e100_seed1_abci3diag_opt1n8g_det0_epoch100_sched_epoch_seed1_fcos1000_eval" \
  --diagnostic "dmae_gate=${ROOT_DIR}/output/nerf_rpn/results/nerfmae_dmae_target_alpha_gated_rgb_p1.0_e100_seed1_abci3dmae_e100_det0_1n8g_epoch100_sched_epoch_seed1_fcos1000_eval" \
  --diagnostic "dmae_concat=${ROOT_DIR}/output/nerf_rpn/results/nerfmae_dmae_hier_concat_p1.0_e100_seed1_abci3dmae_e100_det0_1n8g_epoch100_sched_epoch_seed1_fcos1000_eval" \
  --diagnostic "dmae_film=${ROOT_DIR}/output/nerf_rpn/results/nerfmae_dmae_hier_film_p1.0_e100_seed1_abci3dmae_e100_det0_1n8g_epoch100_sched_epoch_seed1_fcos1000_eval"

"${PROBE_ENV_PREFIX}/bin/python" "${ROOT_DIR}/nerf_rpn/tools/summarize_proposal_quality.py" \
  --gt-boxes-dir "${GT_BOXES_DIR}" \
  --device cuda:0 \
  --output-json "${OUTPUT_DIR}/e300_gate_pre1_ft123.json" \
  --output-md "${OUTPUT_DIR}/e300_gate_pre1_ft123.md" \
  --diagnostic "baseline_ft1=${ROOT_DIR}/output/nerf_rpn/results/nerfmae_all_p1.0_e300_seed1_abci3clean_epoch300_sched_epoch_seed1_fcos1000_eval" \
  --diagnostic "baseline_ft2=${ROOT_DIR}/output/nerf_rpn/results/nerfmae_all_p1.0_e300_seed1_abci3clean_epoch300_sched_epoch_preseed1_ftseed2_fcos1000_eval" \
  --diagnostic "baseline_ft3=${ROOT_DIR}/output/nerf_rpn/results/nerfmae_all_p1.0_e300_seed1_abci3clean_epoch300_sched_epoch_preseed1_ftseed3_fcos1000_eval" \
  --diagnostic "cosine_ft1=${ROOT_DIR}/output/nerf_rpn/results/nerfmae_alpha_rgba_curr_cosine_ramp_p1.0_e300_seed1_abci3clean_epoch300_sched_epoch_seed1_fcos1000_eval" \
  --diagnostic "cosine_ft2=${ROOT_DIR}/output/nerf_rpn/results/nerfmae_alpha_rgba_curr_cosine_ramp_p1.0_e300_seed1_abci3clean_epoch300_sched_epoch_preseed1_ftseed2_fcos1000_eval" \
  --diagnostic "cosine_ft3=${ROOT_DIR}/output/nerf_rpn/results/nerfmae_alpha_rgba_curr_cosine_ramp_p1.0_e300_seed1_abci3clean_epoch300_sched_epoch_preseed1_ftseed3_fcos1000_eval" \
  --diagnostic "shuffle_ft1=${ROOT_DIR}/output/nerf_rpn/results/nerfmae_alpha_rgba_curr_cosine_ramp_alpha_shuffle_p1.0_e300_seed1_abci3clean_epoch300_sched_epoch_seed1_fcos1000_eval" \
  --diagnostic "shuffle_ft2=${ROOT_DIR}/output/nerf_rpn/results/nerfmae_alpha_rgba_curr_cosine_ramp_alpha_shuffle_p1.0_e300_seed1_abci3clean_epoch300_sched_epoch_preseed1_ftseed2_fcos1000_eval" \
  --diagnostic "shuffle_ft3=${ROOT_DIR}/output/nerf_rpn/results/nerfmae_alpha_rgba_curr_cosine_ramp_alpha_shuffle_p1.0_e300_seed1_abci3clean_epoch300_sched_epoch_preseed1_ftseed3_fcos1000_eval"

echo "[info] proposal quality summaries complete output_dir=${OUTPUT_DIR}"
