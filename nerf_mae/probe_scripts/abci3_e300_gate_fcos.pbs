#!/usr/bin/env bash
#PBS -q rt_HG
#PBS -l select=1
#PBS -l walltime=72:00:00
#PBS -P gag51404
#PBS -j oe

set -euo pipefail

cd "${PBS_O_WORKDIR:?PBS_O_WORKDIR is not set}"

ROOT_DIR="${ROOT_DIR:-${PBS_O_WORKDIR}}"
KIND="${KIND:?KIND is required}"
CONDITION="${CONDITION:?CONDITION is required}"
EPOCHS="${EPOCHS:?EPOCHS is required}"
SEED="${SEED:?SEED is required}"
FINETUNE_SEED="${FINETUNE_SEED:-${SEED}}"
RUN_SUFFIX="${RUN_SUFFIX:-abci3clean}"

PROBE_ENV_PREFIX="${PROBE_ENV_PREFIX:-${ROOT_DIR}/.venv-abci3}"
FCOS_DATA_ROOT="${FCOS_DATA_ROOT:-${ROOT_DIR}/dataset/finetune/front3d_rpn_data}"
ABCI3_CUDA_MODULE="${ABCI3_CUDA_MODULE:-cuda/11.8/11.8.0}"
FCOS_GPU_IDS="${FCOS_GPU_IDS:-0}"
FCOS_NUM_EPOCHS="${FCOS_NUM_EPOCHS:-1000}"
FCOS_BATCH_SIZE_PER_GPU="${FCOS_BATCH_SIZE_PER_GPU:-2}"
FCOS_LR="${FCOS_LR:-1e-4}"
FCOS_WEIGHT_DECAY="${FCOS_WEIGHT_DECAY:-1e-3}"
FCOS_LR_SCHEDULER="${FCOS_LR_SCHEDULER:-onecycle_epoch}"
SKIP_EXISTING="${SKIP_EXISTING:-1}"
USE_WANDB="${USE_WANDB:-0}"
WANDB_MODE="${WANDB_MODE:-offline}"
DETERMINISTIC="${DETERMINISTIC:-1}"

suffix_part=""
if [[ -n "${RUN_SUFFIX}" ]]; then
  suffix_part="_${RUN_SUFFIX}"
fi

case "${KIND}:${CONDITION}" in
  baseline:baseline)
    PRETRAIN_SAVE_NAME="nerfmae_all_p1.0_e${EPOCHS}_seed${SEED}${suffix_part}"
    VARIANT_NAME=baseline
    ;;
  curriculum:cosine_ramp|curriculum:cosine_ramp_alpha_shuffle)
    PRETRAIN_SAVE_NAME="nerfmae_alpha_rgba_curr_${CONDITION}_p1.0_e${EPOCHS}_seed${SEED}${suffix_part}"
    VARIANT_NAME="${CONDITION}"
    ;;
  diagnostic:alpha_target_only|diagnostic:alpha_target_only_no_pos|diagnostic:alpha_target_only_coord_jitter|diagnostic:baseline_no_pos|diagnostic:baseline_coord_jitter|diagnostic:cosine_no_pos|diagnostic:cosine_coord_jitter|diagnostic:dmae_target_alpha_gated_rgb|diagnostic:dmae_hier_concat|diagnostic:dmae_hier_concat_coord_jitter|diagnostic:dmae_hier_film)
    PRETRAIN_SAVE_NAME="nerfmae_${CONDITION}_p1.0_e${EPOCHS}_seed${SEED}${suffix_part}"
    VARIANT_NAME="${CONDITION}"
    ;;
  surface_maturation:surface_maturation_tau0p3_k10_w0p05|surface_maturation:surface_maturation_tau0p5_k20_w0p05|surface_maturation:surface_maturation_tau0p7_k30_w0p05|surface_maturation:input_alpha_curriculum)
    PRETRAIN_SAVE_NAME="nerfmae_${CONDITION}_p1.0_e${EPOCHS}_seed${SEED}${suffix_part}"
    VARIANT_NAME="${CONDITION}"
    ;;
  pyramid:pyramid_alpha|pyramid:pyramid_rgb|pyramid:pyramid_both)
    PRETRAIN_SAVE_NAME="nerfmae_${CONDITION}_p1.0_e${EPOCHS}_seed${SEED}${suffix_part}"
    VARIANT_NAME="${CONDITION}"
    ;;
  *)
    echo "[error] unknown KIND:CONDITION=${KIND}:${CONDITION}" >&2
    exit 1
    ;;
esac

PRETRAIN_CHECKPOINT="${ROOT_DIR}/output/nerf_mae/results/${PRETRAIN_SAVE_NAME}/epoch_${EPOCHS}.pt"
if [[ "${FINETUNE_SEED}" == "${SEED}" ]]; then
  SAVE_NAME="${PRETRAIN_SAVE_NAME}_epoch${EPOCHS}_sched_epoch_seed${SEED}_fcos${FCOS_NUM_EPOCHS}"
else
  SAVE_NAME="${PRETRAIN_SAVE_NAME}_epoch${EPOCHS}_sched_epoch_preseed${SEED}_ftseed${FINETUNE_SEED}_fcos${FCOS_NUM_EPOCHS}"
fi
EVAL_JSON="${ROOT_DIR}/output/nerf_rpn/results/${SAVE_NAME}_eval/eval.json"

if [[ "${SKIP_EXISTING}" == "1" && -f "${EVAL_JSON}" ]]; then
  echo "[info] skip existing FCOS eval=${EVAL_JSON}"
  exit 0
fi
if [[ ! -f "${PRETRAIN_CHECKPOINT}" ]]; then
  echo "[error] missing pretrain checkpoint=${PRETRAIN_CHECKPOINT}" >&2
  exit 1
fi

source /etc/profile.d/modules.sh
module load "${ABCI3_CUDA_MODULE}"

export PROBE_PYTHON_BIN="${PROBE_ENV_PREFIX}/bin/python"
export PROBE_ENV_PREFIX
export PROBE_RUNTIME_ROOT="${PROBE_RUNTIME_ROOT:-${ROOT_DIR}/runtime}"
export PROBE_LOG_ROOT_DEFAULT="${PROBE_LOG_ROOT_DEFAULT:-${ROOT_DIR}/output/launcher}"
export WANDB_DIR="${WANDB_DIR:-${ROOT_DIR}/output/wandb}"
export TMPDIR="${TMPDIR:-${ROOT_DIR}/runtime/tmp}"
export TORCH_EXTENSIONS_DIR="${TORCH_EXTENSIONS_DIR:-${ROOT_DIR}/runtime/torch_extensions}"
export XDG_CACHE_HOME="${XDG_CACHE_HOME:-${ROOT_DIR}/runtime/cache}"
export TORCH_HOME="${TORCH_HOME:-${ROOT_DIR}/runtime/torch_home}"
export WANDB_MODE
export PYTHONPATH="${ROOT_DIR}"
export PATH="${PROBE_ENV_PREFIX}/bin:${PATH}"

mkdir -p "${ROOT_DIR}/output/launcher" "${ROOT_DIR}/runtime"

if ! (
  cd "${ROOT_DIR}/nerf_rpn"
  "${PROBE_PYTHON_BIN}" - <<'PY'
import torch
import sort_vertices
print("sort_vertices import ok")
PY
); then
  echo "[info] sort_vertices import missing; building rotated_iou"
  (
    cd "${ROOT_DIR}/nerf_rpn"
    bash "${ROOT_DIR}/nerf_rpn/build_rotated_iou.sh"
  )
fi

PRETRAIN_SAVE_NAME="${PRETRAIN_SAVE_NAME}" \
VARIANT_NAME="${VARIANT_NAME}" \
PRETRAIN_CHECKPOINT="${PRETRAIN_CHECKPOINT}" \
GPU_IDS="${FCOS_GPU_IDS}" \
DATASET_NAME=front3d \
SPLIT_NAME=3dfront \
DATA_ROOT="${FCOS_DATA_ROOT}" \
PERCENT_TRAIN=1.0 \
FCOS_NUM_EPOCHS="${FCOS_NUM_EPOCHS}" \
FCOS_LR="${FCOS_LR}" \
FCOS_WEIGHT_DECAY="${FCOS_WEIGHT_DECAY}" \
FCOS_BATCH_SIZE_PER_GPU="${FCOS_BATCH_SIZE_PER_GPU}" \
USE_WANDB="${USE_WANDB}" \
WANDB_MODE="${WANDB_MODE}" \
SAVE_NAME="${SAVE_NAME}" \
RUN_TAG="${SAVE_NAME}" \
SEED="${FINETUNE_SEED}" \
DETERMINISTIC="${DETERMINISTIC}" \
LR_SCHEDULER="${FCOS_LR_SCHEDULER}" \
bash "${ROOT_DIR}/nerf_rpn/run_fcos_probe_variant.sh"

test -f "${EVAL_JSON}"
echo "[info] FCOS complete eval=${EVAL_JSON}"
