#!/usr/bin/env bash
#PBS -q rt_HF
#PBS -l select=1
#PBS -l walltime=12:00:00
#PBS -P gag51404
#PBS -j oe
#PBS -N grad_conflict

set -euo pipefail

cd "${PBS_O_WORKDIR:?PBS_O_WORKDIR is not set}"

ROOT_DIR="${ROOT_DIR:-${PBS_O_WORKDIR}}"
PROBE_ENV_PREFIX="${PROBE_ENV_PREFIX:-${ROOT_DIR}/.venv-abci3}"
PRETRAIN_DATA_ROOT="${PRETRAIN_DATA_ROOT:-${ROOT_DIR}/dataset/pretrain}"
ABCI3_CUDA_MODULE="${ABCI3_CUDA_MODULE:-cuda/11.8/11.8.0}"
GPU_IDS="${GPU_IDS:-0,1,2,3,4,5,6,7}"
NUM_EPOCHS="${NUM_EPOCHS:-5}"
SEED="${SEED:-1}"
RUN_NAME="${RUN_NAME:-grad_conflict_baseline_seed${SEED}}"
GM_CONDITION="${GM_CONDITION:-baseline}"
GM_INTERVAL="${GM_INTERVAL:-20}"
GM_MAX_BATCHES="${GM_MAX_BATCHES:-2}"
GM_PARAM_FILTER="${GM_PARAM_FILTER:-stages}"
BATCH_SIZE_PER_GPU="${BATCH_SIZE_PER_GPU:-2}"
BATCH_SIZE="${BATCH_SIZE:-16}"
LR="${LR:-1e-3}"
WEIGHT_DECAY="${WEIGHT_DECAY:-0.0}"
LOG_INTERVAL="${LOG_INTERVAL:-10}"
TRAIN_NUM_WORKERS="${TRAIN_NUM_WORKERS:-}"
EVAL_NUM_WORKERS="${EVAL_NUM_WORKERS:-}"
PERSISTENT_WORKERS="${PERSISTENT_WORKERS:-0}"
USE_WANDB="${USE_WANDB:-0}"
WANDB_MODE="${WANDB_MODE:-offline}"
DETERMINISTIC="${DETERMINISTIC:-0}"
ROTATE_PROB="${ROTATE_PROB:-}"
FLIP_PROB="${FLIP_PROB:-}"
ROT_SCALE_PROB="${ROT_SCALE_PROB:-}"
COORD_SHIFT_PROB="${COORD_SHIFT_PROB:-}"
COORD_SHIFT_MAX_VOXELS="${COORD_SHIFT_MAX_VOXELS:-}"

source /etc/profile.d/modules.sh
module load "${ABCI3_CUDA_MODULE}"

export PROBE_ENV_PREFIX
export WANDB_MODE
export PYTHONPATH="${ROOT_DIR}"
export PATH="${PROBE_ENV_PREFIX}/bin:${PATH}"
export GM_INTERVAL GM_MAX_BATCHES GM_PARAM_FILTER

mkdir -p "${ROOT_DIR}/output/launcher" "${ROOT_DIR}/runtime"

case "${GM_CONDITION}" in
  baseline)
    probe_env=(PROBE_MODE=baseline)
    ;;
  cosine_coord_jitter)
    probe_env=(
      PROBE_MODE=custom
      PROBE_RGB_INPUT=keep
      PROBE_ALPHA_INPUT=keep
      PROBE_ALPHA_TARGET=keep
      PROBE_RGB_LOSS=occupied
      PROBE_ALPHA_LOSS=removed
      PROBE_RGB_WEIGHT=1.0
      PROBE_ALPHA_WEIGHT=1.0
      PROBE_CURRICULUM=cosine_rgb_ramp
      PROBE_CURRICULUM_EPOCHS="${NUM_EPOCHS}"
      PROBE_CURRICULUM_RGB_START_WEIGHT=0.0
      PROBE_CURRICULUM_RGB_END_WEIGHT=1.0
      PROBE_CURRICULUM_ALPHA_WEIGHT=1.0
      ROTATE_PROB="${ROTATE_PROB:-1.0}"
      FLIP_PROB="${FLIP_PROB:-0.5}"
      ROT_SCALE_PROB="${ROT_SCALE_PROB:-0.0}"
      COORD_SHIFT_PROB="${COORD_SHIFT_PROB:-1.0}"
      COORD_SHIFT_MAX_VOXELS="${COORD_SHIFT_MAX_VOXELS:-8}"
    )
    ;;
  *)
    echo "[error] unsupported GM_CONDITION=${GM_CONDITION}" >&2
    exit 1
    ;;
esac

cd "${ROOT_DIR}/nerf_mae"

env \
  DATA_ROOT="${PRETRAIN_DATA_ROOT}" \
  DATASET_NAME=nerfmae \
  SAVE_NAME="${RUN_NAME}" \
  RUN_TAG="${RUN_NAME}" \
  GPU_IDS="${GPU_IDS}" \
  NUM_EPOCHS="${NUM_EPOCHS}" \
  BATCH_SIZE="${BATCH_SIZE}" \
  BATCH_SIZE_PER_GPU="${BATCH_SIZE_PER_GPU}" \
  LR="${LR}" \
  WEIGHT_DECAY="${WEIGHT_DECAY}" \
  LOG_INTERVAL="${LOG_INTERVAL}" \
  EVAL_INTERVAL=100000 \
  CHECKPOINT_INTERVAL=0 \
  TRAIN_NUM_WORKERS="${TRAIN_NUM_WORKERS}" \
  EVAL_NUM_WORKERS="${EVAL_NUM_WORKERS}" \
  PERSISTENT_WORKERS="${PERSISTENT_WORKERS}" \
  USE_WANDB="${USE_WANDB}" \
  WANDB_MODE="${WANDB_MODE}" \
  SEED="${SEED}" \
  DETERMINISTIC="${DETERMINISTIC}" \
  TRAIN_ENTRYPOINT=run_swin_grad_monitor.py \
  "${probe_env[@]}" \
  bash train_mae3d.sh
