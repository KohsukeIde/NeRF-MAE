#!/usr/bin/env bash
#PBS -q rt_HF
#PBS -l select=1
#PBS -l walltime=72:00:00
#PBS -P gag51404
#PBS -j oe

set -euo pipefail

cd "${PBS_O_WORKDIR:?PBS_O_WORKDIR is not set}"

ROOT_DIR="${ROOT_DIR:-${PBS_O_WORKDIR}}"
KIND="${KIND:?KIND is required}"
CONDITION="${CONDITION:?CONDITION is required}"
EPOCHS="${EPOCHS:?EPOCHS is required}"
SEED="${SEED:?SEED is required}"
RUN_SUFFIX="${RUN_SUFFIX:-abci3clean}"

PROBE_ENV_PREFIX="${PROBE_ENV_PREFIX:-${ROOT_DIR}/.venv-abci3}"
PRETRAIN_DATA_ROOT="${PRETRAIN_DATA_ROOT:-${ROOT_DIR}/dataset/pretrain}"
ABCI3_CUDA_MODULE="${ABCI3_CUDA_MODULE:-cuda/11.8/11.8.0}"
PRETRAIN_GPU_IDS="${PRETRAIN_GPU_IDS:-0,1,2,3,4,5,6,7}"
PRETRAIN_GPU_IDS="${PRETRAIN_GPU_IDS//:/,}"
PRETRAIN_NODES="${PRETRAIN_NODES:-}"
PRETRAIN_BATCH_SIZE_PER_GPU="${PRETRAIN_BATCH_SIZE_PER_GPU:-}"
PRETRAIN_LR="${PRETRAIN_LR:-1e-3}"
PRETRAIN_WEIGHT_DECAY="${PRETRAIN_WEIGHT_DECAY:-0.0}"
PRETRAIN_EVAL_INTERVAL="${PRETRAIN_EVAL_INTERVAL:-10}"
PRETRAIN_CHECKPOINT_INTERVAL="${PRETRAIN_CHECKPOINT_INTERVAL:-50}"
PRETRAIN_KEEP_CHECKPOINTS="${PRETRAIN_KEEP_CHECKPOINTS:-0}"
PRETRAIN_LOG_INTERVAL="${PRETRAIN_LOG_INTERVAL:-30}"
PRETRAIN_PROFILE_STEP_TIME="${PRETRAIN_PROFILE_STEP_TIME:-0}"
PRETRAIN_TRAIN_NUM_WORKERS="${PRETRAIN_TRAIN_NUM_WORKERS:-}"
PRETRAIN_EVAL_NUM_WORKERS="${PRETRAIN_EVAL_NUM_WORKERS:-}"
PRETRAIN_PERSISTENT_WORKERS="${PRETRAIN_PERSISTENT_WORKERS:-0}"
STAGE_PRETRAIN_DATA="${STAGE_PRETRAIN_DATA:-0}"
PRETRAIN_DATA_SRC="${PRETRAIN_DATA_SRC:-${PRETRAIN_DATA_ROOT}}"
LOCAL_STAGE_ROOT="${LOCAL_STAGE_ROOT:-}"
STAGE_KEEP="${STAGE_KEEP:-0}"
STAGE_MIN_FREE_GB="${STAGE_MIN_FREE_GB:-80}"
DISABLE_ABS_POS_EMBED="${DISABLE_ABS_POS_EMBED:-0}"
DISABLE_RELATIVE_POSITION_BIAS="${DISABLE_RELATIVE_POSITION_BIAS:-0}"
ROTATE_PROB="${ROTATE_PROB:-}"
FLIP_PROB="${FLIP_PROB:-}"
ROT_SCALE_PROB="${ROT_SCALE_PROB:-}"
COORD_SHIFT_PROB="${COORD_SHIFT_PROB:-}"
COORD_SHIFT_MAX_VOXELS="${COORD_SHIFT_MAX_VOXELS:-}"
SM_MODE="${SM_MODE:-}"
SM_CONFIDENCE="${SM_CONFIDENCE:-}"
SM_W_MIN="${SM_W_MIN:-}"
SM_TAU="${SM_TAU:-}"
SM_K="${SM_K:-}"
SM_STOP_GATE_GRAD="${SM_STOP_GATE_GRAD:-}"
SM_RGB_MASK="${SM_RGB_MASK:-}"
SM_INPUT_RGB_CURRICULUM="${SM_INPUT_RGB_CURRICULUM:-}"
SM_INPUT_RGB_START="${SM_INPUT_RGB_START:-}"
SM_INPUT_RGB_END="${SM_INPUT_RGB_END:-}"
SM_INPUT_RGB_EPOCHS="${SM_INPUT_RGB_EPOCHS:-}"
SM_LOG_STATS="${SM_LOG_STATS:-}"
PYR_MODE="${PYR_MODE:-}"
PYR_SCALE="${PYR_SCALE:-}"
PYR_SCHEDULE="${PYR_SCHEDULE:-}"
PYR_EPOCHS="${PYR_EPOCHS:-}"
PYR_ALPHA_POOL="${PYR_ALPHA_POOL:-}"
PYR_RGB_POOL="${PYR_RGB_POOL:-}"
PYR_UPSAMPLE="${PYR_UPSAMPLE:-}"
PYR_ALPHA_UPSAMPLE="${PYR_ALPHA_UPSAMPLE:-}"
PYR_LOG_STATS="${PYR_LOG_STATS:-}"
BOUNDARY_SDF_MODE="${BOUNDARY_SDF_MODE:-}"
BOUNDARY_SDF_WEIGHT="${BOUNDARY_SDF_WEIGHT:-}"
BOUNDARY_ALPHA_SMOOTH_SIGMA="${BOUNDARY_ALPHA_SMOOTH_SIGMA:-}"
BOUNDARY_ALPHA_THRESHOLD="${BOUNDARY_ALPHA_THRESHOLD:-}"
BOUNDARY_DISTANCE_CLIP="${BOUNDARY_DISTANCE_CLIP:-}"
BOUNDARY_SDF_LOSS="${BOUNDARY_SDF_LOSS:-}"
BOUNDARY_SDF_MASK="${BOUNDARY_SDF_MASK:-}"
MIXNERF_MODE="${MIXNERF_MODE:-}"
MIXNERF_MASK_RATIO="${MIXNERF_MASK_RATIO:-}"
MIXNERF_PARTNER="${MIXNERF_PARTNER:-}"
MIXNERF_FILL_MODE="${MIXNERF_FILL_MODE:-}"
MIXNERF_PATCH_SIZE="${MIXNERF_PATCH_SIZE:-}"
MIXNERF_DISABLE_INTERNAL_MASK="${MIXNERF_DISABLE_INTERNAL_MASK:-}"
MIXNERF_LOG_STATS="${MIXNERF_LOG_STATS:-}"
MIXNERF_PROBE_MODE="${MIXNERF_PROBE_MODE:-}"
MIXNERF_PROBE_RGB_LOSS="${MIXNERF_PROBE_RGB_LOSS:-}"
MIXNERF_PROBE_ALPHA_LOSS="${MIXNERF_PROBE_ALPHA_LOSS:-}"
MIXNERF_PROBE_RGB_INPUT="${MIXNERF_PROBE_RGB_INPUT:-}"
MIXNERF_PROBE_ALPHA_INPUT="${MIXNERF_PROBE_ALPHA_INPUT:-}"
MIXNERF_PROBE_ALPHA_TARGET="${MIXNERF_PROBE_ALPHA_TARGET:-}"
VISGATE_MODE="${VISGATE_MODE:-}"
VISGATE_RESET_STAGES="${VISGATE_RESET_STAGES:-}"
VISGATE_SKIP_STAGES="${VISGATE_SKIP_STAGES:-}"
VISGATE_LOG_STATS="${VISGATE_LOG_STATS:-}"
AUTO_RESUME_PRETRAIN="${AUTO_RESUME_PRETRAIN:-1}"
RESUME_ALLOW_PARTIAL="${RESUME_ALLOW_PARTIAL:-1}"
SKIP_EXISTING="${SKIP_EXISTING:-1}"
USE_WANDB="${USE_WANDB:-0}"
WANDB_MODE="${WANDB_MODE:-offline}"
DETERMINISTIC="${DETERMINISTIC:-1}"
PRETRAIN_MASTER_PORT="${PRETRAIN_MASTER_PORT:-29500}"

normalize_empty_literal() {
  local name="$1"
  local value="${!name:-}"
  if [[ "${value}" == "''" || "${value}" == '""' ]]; then
    printf -v "${name}" '%s' ""
  fi
}

for optional_arg in \
  ROTATE_PROB \
  FLIP_PROB \
  ROT_SCALE_PROB \
  COORD_SHIFT_PROB \
  COORD_SHIFT_MAX_VOXELS \
  PRETRAIN_TRAIN_NUM_WORKERS \
  PRETRAIN_EVAL_NUM_WORKERS \
  LOCAL_STAGE_ROOT
do
  normalize_empty_literal "${optional_arg}"
done

count_gpu_ids() {
  local spec="$1"
  local count=0 token start end
  IFS=',' read -r -a tokens <<< "${spec}"
  for token in "${tokens[@]}"; do
    token="${token//[[:space:]]/}"
    [[ -n "${token}" ]] || continue
    if [[ "${token}" == *-* ]]; then
      IFS='-' read -r start end <<< "${token}"
      count=$((count + end - start + 1))
    else
      count=$((count + 1))
    fi
  done
  [[ "${count}" -gt 0 ]] || count=1
  printf "%s\n" "${count}"
}

pbs_unique_node_count() {
  if [[ -n "${PBS_NODEFILE:-}" && -f "${PBS_NODEFILE}" ]]; then
    awk '!seen[$0]++ { count++ } END { print count + 0 }' "${PBS_NODEFILE}"
  else
    printf "1\n"
  fi
}

write_unique_hosts() {
  local out="$1"
  if [[ -n "${PBS_NODEFILE:-}" && -f "${PBS_NODEFILE}" ]]; then
    awk '!seen[$0]++ { print }' "${PBS_NODEFILE}" > "${out}"
  else
    hostname > "${out}"
  fi
}

resolve_node_rank() {
  local hosts_file="$1"
  local host short
  host="$(hostname)"
  short="${host%%.*}"
  awk -v host="${host}" -v short="${short}" '
    {
      candidate=$1
      candidate_short=candidate
      sub(/\..*/, "", candidate_short)
      if (candidate == host || candidate_short == short) {
        print NR - 1
        found=1
        exit
      }
    }
    END {
      if (!found) {
        exit 1
      }
    }
  ' "${hosts_file}"
}

configure_node_network() {
  local iface=""
  if command -v ip >/dev/null 2>&1; then
    iface="$(ip -o link show 2>/dev/null | awk -F': ' '/: ibp/ { print $2; exit }')"
  fi
  if [[ -n "${iface}" ]]; then
    export NCCL_SOCKET_IFNAME="${NCCL_SOCKET_IFNAME:-${iface}}"
    export GLOO_SOCKET_IFNAME="${GLOO_SOCKET_IFNAME:-${iface}}"
  fi
  export NCCL_IB_HCA="${NCCL_IB_HCA:-mlx5_0,mlx5_1}"
  export NCCL_DEBUG="${NCCL_DEBUG:-WARN}"
}

suffix_part=""
if [[ -n "${RUN_SUFFIX}" ]]; then
  suffix_part="_${RUN_SUFFIX}"
fi

case "${KIND}:${CONDITION}" in
  baseline:baseline)
    SAVE_NAME="nerfmae_all_p1.0_e${EPOCHS}_seed${SEED}${suffix_part}"
    ;;
  curriculum:cosine_ramp|curriculum:cosine_ramp_alpha_shuffle|curriculum:cosine_ramp_coord_jitter|curriculum:linear_ramp_coord_jitter|curriculum:step_ramp_coord_jitter|curriculum:reverse_ramp_coord_jitter|curriculum:constant_mixed_coord_jitter)
    SAVE_NAME="nerfmae_alpha_rgba_curr_${CONDITION}_p1.0_e${EPOCHS}_seed${SEED}${suffix_part}"
    ;;
  diagnostic:paper_loss|diagnostic:alpha_target_only|diagnostic:alpha_target_only_no_pos|diagnostic:alpha_target_only_coord_jitter|diagnostic:baseline_no_pos|diagnostic:baseline_coord_jitter|diagnostic:cosine_no_pos|diagnostic:cosine_coord_jitter|diagnostic:shuffle_coord_jitter|diagnostic:dmae_target_alpha_gated_rgb|diagnostic:dmae_hier_concat|diagnostic:dmae_hier_concat_coord_jitter|diagnostic:dmae_hier_film)
    SAVE_NAME="nerfmae_${CONDITION}_p1.0_e${EPOCHS}_seed${SEED}${suffix_part}"
    ;;
  surface_maturation:surface_maturation_tau0p3_k10_w0p05|surface_maturation:surface_maturation_tau0p5_k20_w0p05|surface_maturation:surface_maturation_tau0p7_k30_w0p05|surface_maturation:surface_maturation_cosine_coord_jitter_tau0p7_k30_w0p05|surface_maturation:input_alpha_curriculum)
    SAVE_NAME="nerfmae_${CONDITION}_p1.0_e${EPOCHS}_seed${SEED}${suffix_part}"
    ;;
  pyramid:pyramid_alpha|pyramid:pyramid_rgb|pyramid:pyramid_both)
    SAVE_NAME="nerfmae_${CONDITION}_p1.0_e${EPOCHS}_seed${SEED}${suffix_part}"
    ;;
  boundary_sdf:boundary_sdf_aux)
    SAVE_NAME="nerfmae_${CONDITION}_p1.0_e${EPOCHS}_seed${SEED}${suffix_part}"
    ;;
  mixnerf:mixnerf_lite|mixnerf:mixnerf_lite_zeros|mixnerf:mixnerf_lite_noise|mixnerf:mixnerf_lite_shuffle|mixnerf:mixnerf_lite_shuffle_visible|mixnerf:mixnerf_lite_mean|mixnerf:mixnerf_lite_masked|mixnerf:mixnerf_lite_zeros_masked|mixnerf:mixnerf_lite_noise_masked|mixnerf:mixnerf_lite_shuffle_masked|mixnerf:mixnerf_lite_shuffle_visible_masked|mixnerf:mixnerf_lite_mean_masked)
    SAVE_NAME="nerfmae_${CONDITION}_p1.0_e${EPOCHS}_seed${SEED}${suffix_part}"
    ;;
  visibility:visibility_feature_reset|visibility:visibility_skip_gate|visibility:visibility_reset_skip)
    SAVE_NAME="nerfmae_${CONDITION}_p1.0_e${EPOCHS}_seed${SEED}${suffix_part}"
    ;;
  *)
    echo "[error] unknown KIND:CONDITION=${KIND}:${CONDITION}" >&2
    exit 1
    ;;
esac

CHECKPOINT_PATH="${ROOT_DIR}/output/nerf_mae/results/${SAVE_NAME}/epoch_${EPOCHS}.pt"
if [[ "${SKIP_EXISTING}" == "1" && -f "${CHECKPOINT_PATH}" ]]; then
  echo "[info] skip existing pretrain checkpoint=${CHECKPOINT_PATH}"
  exit 0
fi

latest_epoch_checkpoint() {
  local dir="${ROOT_DIR}/output/nerf_mae/results/${SAVE_NAME}"
  [[ -d "${dir}" ]] || return 0
  find "${dir}" -maxdepth 1 -name 'epoch_*.pt' -print | sort -V | tail -n 1
}

if [[ "${1:-}" == "--resolve-node-rank" ]]; then
  resolve_node_rank "${2:?hosts file is required}"
  exit 0
fi

PRETRAIN_LOCAL_WORLD_SIZE="$(count_gpu_ids "${PRETRAIN_GPU_IDS}")"
if [[ -z "${PRETRAIN_NODES}" ]]; then
  PRETRAIN_NODES="$(pbs_unique_node_count)"
fi
PRETRAIN_WORLD_SIZE=$((PRETRAIN_NODES * PRETRAIN_LOCAL_WORLD_SIZE))
if [[ -z "${PRETRAIN_BATCH_SIZE_PER_GPU}" ]]; then
  if (( PRETRAIN_NODES > 1 )); then
    PRETRAIN_BATCH_SIZE_PER_GPU=1
  else
    PRETRAIN_BATCH_SIZE_PER_GPU=2
  fi
fi
PRETRAIN_BATCH_SIZE="${PRETRAIN_BATCH_SIZE:-$((PRETRAIN_WORLD_SIZE * PRETRAIN_BATCH_SIZE_PER_GPU))}"

if (( PRETRAIN_NODES > 1 && ${ABCI3_NODE_ENTRY:-0} != 1 )); then
  command -v pbsdsh >/dev/null 2>&1 || {
    echo "[error] pbsdsh is required for PRETRAIN_NODES=${PRETRAIN_NODES}" >&2
    exit 1
  }

  mkdir -p "${ROOT_DIR}/runtime/abci3_multinode"
  HOSTS_FILE="${ROOT_DIR}/runtime/abci3_multinode/${SAVE_NAME}.${PBS_JOBID:-$$}.hosts"
  NODE_ENTRY="${ROOT_DIR}/runtime/abci3_multinode/${SAVE_NAME}.${PBS_JOBID:-$$}.node_entry.sh"
  STATUS_DIR="${ROOT_DIR}/runtime/abci3_multinode/${SAVE_NAME}.${PBS_JOBID:-$$}.status"
  rm -rf "${STATUS_DIR}"
  mkdir -p "${STATUS_DIR}"
  write_unique_hosts "${HOSTS_FILE}"

  actual_nodes="$(wc -l < "${HOSTS_FILE}" | tr -d '[:space:]')"
  if [[ "${actual_nodes}" != "${PRETRAIN_NODES}" ]]; then
    echo "[error] PRETRAIN_NODES=${PRETRAIN_NODES}, but PBS allocated ${actual_nodes} unique nodes" >&2
    exit 1
  fi

  MASTER_HOST="$(sed -n '1p' "${HOSTS_FILE}")"
  MASTER_ADDR="$(getent ahostsv4 "${MASTER_HOST}" | awk '{ print $1; exit }')"
  MASTER_ADDR="${MASTER_ADDR:-${MASTER_HOST}}"

  PRETRAIN_SCRIPT_PATH="${ROOT_DIR}/nerf_mae/probe_scripts/abci3_e300_gate_pretrain.pbs"
  export ABCI3_PRETRAIN_SCRIPT="${PRETRAIN_SCRIPT_PATH}"
  export ABCI3_PRETRAIN_HOSTS_FILE="${HOSTS_FILE}"
  export ABCI3_PRETRAIN_STATUS_DIR="${STATUS_DIR}"
  export NERFMAE_DDP_USE_ENV=1
  export NERFMAE_DDP_NUM_NODES="${PRETRAIN_NODES}"
  export NERFMAE_DDP_WORLD_SIZE="${PRETRAIN_WORLD_SIZE}"
  export NERFMAE_DDP_MASTER_ADDR="${MASTER_ADDR}"
  export NERFMAE_DDP_MASTER_PORT="${PRETRAIN_MASTER_PORT}"
  export PRETRAIN_BATCH_SIZE
  export PRETRAIN_BATCH_SIZE_PER_GPU

  cat > "${NODE_ENTRY}" <<EOS
#!/usr/bin/env bash
set -euo pipefail

cd "$(printf '%q' "${ROOT_DIR}")"
export ABCI3_PRETRAIN_SCRIPT="$(printf '%q' "${PRETRAIN_SCRIPT_PATH}")"
export ABCI3_PRETRAIN_HOSTS_FILE="$(printf '%q' "${HOSTS_FILE}")"
export ABCI3_PRETRAIN_STATUS_DIR="$(printf '%q' "${STATUS_DIR}")"
export ROOT_DIR="$(printf '%q' "${ROOT_DIR}")"
export KIND="$(printf '%q' "${KIND}")"
export CONDITION="$(printf '%q' "${CONDITION}")"
export EPOCHS="$(printf '%q' "${EPOCHS}")"
export SEED="$(printf '%q' "${SEED}")"
export RUN_SUFFIX="$(printf '%q' "${RUN_SUFFIX}")"
export PROBE_ENV_PREFIX="$(printf '%q' "${PROBE_ENV_PREFIX}")"
export PRETRAIN_DATA_ROOT="$(printf '%q' "${PRETRAIN_DATA_ROOT}")"
export PRETRAIN_DATA_SRC="$(printf '%q' "${PRETRAIN_DATA_SRC}")"
export STAGE_PRETRAIN_DATA="$(printf '%q' "${STAGE_PRETRAIN_DATA}")"
export LOCAL_STAGE_ROOT="$(printf '%q' "${LOCAL_STAGE_ROOT}")"
export STAGE_KEEP="$(printf '%q' "${STAGE_KEEP}")"
export STAGE_MIN_FREE_GB="$(printf '%q' "${STAGE_MIN_FREE_GB}")"
export ABCI3_CUDA_MODULE="$(printf '%q' "${ABCI3_CUDA_MODULE}")"
export AUTO_RESUME_PRETRAIN="$(printf '%q' "${AUTO_RESUME_PRETRAIN}")"
export RESUME_ALLOW_PARTIAL="$(printf '%q' "${RESUME_ALLOW_PARTIAL}")"
export SKIP_EXISTING="$(printf '%q' "${SKIP_EXISTING}")"
export USE_WANDB="$(printf '%q' "${USE_WANDB}")"
export WANDB_MODE="$(printf '%q' "${WANDB_MODE}")"
export DETERMINISTIC="$(printf '%q' "${DETERMINISTIC}")"
export DISABLE_ABS_POS_EMBED="$(printf '%q' "${DISABLE_ABS_POS_EMBED}")"
export DISABLE_RELATIVE_POSITION_BIAS="$(printf '%q' "${DISABLE_RELATIVE_POSITION_BIAS}")"
export ROTATE_PROB="$(printf '%q' "${ROTATE_PROB}")"
export FLIP_PROB="$(printf '%q' "${FLIP_PROB}")"
export ROT_SCALE_PROB="$(printf '%q' "${ROT_SCALE_PROB}")"
export COORD_SHIFT_PROB="$(printf '%q' "${COORD_SHIFT_PROB}")"
export COORD_SHIFT_MAX_VOXELS="$(printf '%q' "${COORD_SHIFT_MAX_VOXELS}")"
export SM_MODE="$(printf '%q' "${SM_MODE}")"
export SM_CONFIDENCE="$(printf '%q' "${SM_CONFIDENCE}")"
export SM_W_MIN="$(printf '%q' "${SM_W_MIN}")"
export SM_TAU="$(printf '%q' "${SM_TAU}")"
export SM_K="$(printf '%q' "${SM_K}")"
export SM_STOP_GATE_GRAD="$(printf '%q' "${SM_STOP_GATE_GRAD}")"
export SM_RGB_MASK="$(printf '%q' "${SM_RGB_MASK}")"
export SM_INPUT_RGB_CURRICULUM="$(printf '%q' "${SM_INPUT_RGB_CURRICULUM}")"
export SM_INPUT_RGB_START="$(printf '%q' "${SM_INPUT_RGB_START}")"
export SM_INPUT_RGB_END="$(printf '%q' "${SM_INPUT_RGB_END}")"
export SM_INPUT_RGB_EPOCHS="$(printf '%q' "${SM_INPUT_RGB_EPOCHS}")"
export SM_LOG_STATS="$(printf '%q' "${SM_LOG_STATS}")"
export PYR_MODE="$(printf '%q' "${PYR_MODE}")"
export PYR_SCALE="$(printf '%q' "${PYR_SCALE}")"
export PYR_SCHEDULE="$(printf '%q' "${PYR_SCHEDULE}")"
export PYR_EPOCHS="$(printf '%q' "${PYR_EPOCHS}")"
export PYR_ALPHA_POOL="$(printf '%q' "${PYR_ALPHA_POOL}")"
export PYR_RGB_POOL="$(printf '%q' "${PYR_RGB_POOL}")"
export PYR_UPSAMPLE="$(printf '%q' "${PYR_UPSAMPLE}")"
export PYR_ALPHA_UPSAMPLE="$(printf '%q' "${PYR_ALPHA_UPSAMPLE}")"
export PYR_LOG_STATS="$(printf '%q' "${PYR_LOG_STATS}")"
export BOUNDARY_SDF_MODE="$(printf '%q' "${BOUNDARY_SDF_MODE}")"
export BOUNDARY_SDF_WEIGHT="$(printf '%q' "${BOUNDARY_SDF_WEIGHT}")"
export BOUNDARY_ALPHA_SMOOTH_SIGMA="$(printf '%q' "${BOUNDARY_ALPHA_SMOOTH_SIGMA}")"
export BOUNDARY_ALPHA_THRESHOLD="$(printf '%q' "${BOUNDARY_ALPHA_THRESHOLD}")"
export BOUNDARY_DISTANCE_CLIP="$(printf '%q' "${BOUNDARY_DISTANCE_CLIP}")"
export BOUNDARY_SDF_LOSS="$(printf '%q' "${BOUNDARY_SDF_LOSS}")"
export BOUNDARY_SDF_MASK="$(printf '%q' "${BOUNDARY_SDF_MASK}")"
export MIXNERF_MODE="$(printf '%q' "${MIXNERF_MODE}")"
export MIXNERF_MASK_RATIO="$(printf '%q' "${MIXNERF_MASK_RATIO}")"
export MIXNERF_PARTNER="$(printf '%q' "${MIXNERF_PARTNER}")"
export MIXNERF_FILL_MODE="$(printf '%q' "${MIXNERF_FILL_MODE}")"
export MIXNERF_PATCH_SIZE="$(printf '%q' "${MIXNERF_PATCH_SIZE}")"
export MIXNERF_DISABLE_INTERNAL_MASK="$(printf '%q' "${MIXNERF_DISABLE_INTERNAL_MASK}")"
export MIXNERF_LOG_STATS="$(printf '%q' "${MIXNERF_LOG_STATS}")"
export MIXNERF_PROBE_MODE="$(printf '%q' "${MIXNERF_PROBE_MODE}")"
export MIXNERF_PROBE_RGB_LOSS="$(printf '%q' "${MIXNERF_PROBE_RGB_LOSS}")"
export MIXNERF_PROBE_ALPHA_LOSS="$(printf '%q' "${MIXNERF_PROBE_ALPHA_LOSS}")"
export MIXNERF_PROBE_RGB_INPUT="$(printf '%q' "${MIXNERF_PROBE_RGB_INPUT}")"
export MIXNERF_PROBE_ALPHA_INPUT="$(printf '%q' "${MIXNERF_PROBE_ALPHA_INPUT}")"
export MIXNERF_PROBE_ALPHA_TARGET="$(printf '%q' "${MIXNERF_PROBE_ALPHA_TARGET}")"
export VISGATE_MODE="$(printf '%q' "${VISGATE_MODE}")"
export VISGATE_RESET_STAGES="$(printf '%q' "${VISGATE_RESET_STAGES}")"
export VISGATE_SKIP_STAGES="$(printf '%q' "${VISGATE_SKIP_STAGES}")"
export VISGATE_LOG_STATS="$(printf '%q' "${VISGATE_LOG_STATS}")"
export NERFMAE_DDP_USE_ENV=1
export NERFMAE_DDP_NUM_NODES="$(printf '%q' "${PRETRAIN_NODES}")"
export NERFMAE_DDP_WORLD_SIZE="$(printf '%q' "${PRETRAIN_WORLD_SIZE}")"
export NERFMAE_DDP_MASTER_ADDR="$(printf '%q' "${MASTER_ADDR}")"
export NERFMAE_DDP_MASTER_PORT="$(printf '%q' "${PRETRAIN_MASTER_PORT}")"
export PRETRAIN_NODES="$(printf '%q' "${PRETRAIN_NODES}")"
export PRETRAIN_BATCH_SIZE="$(printf '%q' "${PRETRAIN_BATCH_SIZE}")"
export PRETRAIN_BATCH_SIZE_PER_GPU="$(printf '%q' "${PRETRAIN_BATCH_SIZE_PER_GPU}")"
export PRETRAIN_GPU_IDS="$(printf '%q' "${PRETRAIN_GPU_IDS}")"
export PRETRAIN_LR="$(printf '%q' "${PRETRAIN_LR}")"
export PRETRAIN_WEIGHT_DECAY="$(printf '%q' "${PRETRAIN_WEIGHT_DECAY}")"
export PRETRAIN_EVAL_INTERVAL="$(printf '%q' "${PRETRAIN_EVAL_INTERVAL}")"
export PRETRAIN_CHECKPOINT_INTERVAL="$(printf '%q' "${PRETRAIN_CHECKPOINT_INTERVAL}")"
export PRETRAIN_KEEP_CHECKPOINTS="$(printf '%q' "${PRETRAIN_KEEP_CHECKPOINTS}")"
export PRETRAIN_LOG_INTERVAL="$(printf '%q' "${PRETRAIN_LOG_INTERVAL}")"
export PRETRAIN_PROFILE_STEP_TIME="$(printf '%q' "${PRETRAIN_PROFILE_STEP_TIME}")"
export PRETRAIN_TRAIN_NUM_WORKERS="$(printf '%q' "${PRETRAIN_TRAIN_NUM_WORKERS}")"
export PRETRAIN_EVAL_NUM_WORKERS="$(printf '%q' "${PRETRAIN_EVAL_NUM_WORKERS}")"
export PRETRAIN_PERSISTENT_WORKERS="$(printf '%q' "${PRETRAIN_PERSISTENT_WORKERS}")"
export PRETRAIN_MASTER_PORT="$(printf '%q' "${PRETRAIN_MASTER_PORT}")"
rank="\$(bash "\${ABCI3_PRETRAIN_SCRIPT}" --resolve-node-rank "\${ABCI3_PRETRAIN_HOSTS_FILE}")"
export NERFMAE_DDP_NODE_RANK="\${rank}"
export ABCI3_NODE_ENTRY=1

if bash "\${ABCI3_PRETRAIN_SCRIPT}"; then
  touch "\${ABCI3_PRETRAIN_STATUS_DIR}/rank_\${rank}.ok"
else
  status=\$?
  touch "\${ABCI3_PRETRAIN_STATUS_DIR}/rank_\${rank}.fail"
  exit "\${status}"
fi
EOS
  chmod +x "${NODE_ENTRY}"

  echo "[info] launching multi-node pretrain nodes=${PRETRAIN_NODES} local_gpus=${PRETRAIN_LOCAL_WORLD_SIZE} world=${PRETRAIN_WORLD_SIZE} master=${MASTER_ADDR}:${PRETRAIN_MASTER_PORT}"
  pbsdsh -c "${PRETRAIN_NODES}" "${NODE_ENTRY}"

  if find "${STATUS_DIR}" -maxdepth 1 -name 'rank_*.fail' | grep -q .; then
    echo "[error] at least one node failed; status dir=${STATUS_DIR}" >&2
    exit 1
  fi
  for rank in $(seq 0 $((PRETRAIN_NODES - 1))); do
    if [[ ! -f "${STATUS_DIR}/rank_${rank}.ok" ]]; then
      echo "[error] missing completion marker for node rank ${rank}; status dir=${STATUS_DIR}" >&2
      exit 1
    fi
  done

  test -f "${CHECKPOINT_PATH}"
  echo "[info] pretrain complete checkpoint=${CHECKPOINT_PATH}"
  exit 0
fi

source /etc/profile.d/modules.sh
module load "${ABCI3_CUDA_MODULE}"
configure_node_network

export PROBE_ENV_PREFIX
export PROBE_RUNTIME_ROOT="${PROBE_RUNTIME_ROOT:-${ROOT_DIR}/runtime}"
export PROBE_LOG_ROOT_DEFAULT="${PROBE_LOG_ROOT_DEFAULT:-${ROOT_DIR}/output/launcher}"
export WANDB_DIR="${WANDB_DIR:-${ROOT_DIR}/output/wandb}"
export TMPDIR="${TMPDIR:-${ROOT_DIR}/runtime/tmp}"
export TORCH_EXTENSIONS_DIR="${TORCH_EXTENSIONS_DIR:-${ROOT_DIR}/runtime/torch_extensions}"
export XDG_CACHE_HOME="${XDG_CACHE_HOME:-${ROOT_DIR}/runtime/cache}"
export TORCH_HOME="${TORCH_HOME:-${ROOT_DIR}/runtime/torch_home}"
export WANDB_MODE
export PYTHONPATH="${ROOT_DIR}"
export PATH="${PROBE_ENV_PREFIX}/bin:${PATH}"

echo "[info] runtime host=$(hostname) cuda_module=${ABCI3_CUDA_MODULE} python=$(command -v python3 || true)"
echo "[info] runtime nccl_socket=${NCCL_SOCKET_IFNAME:-unset} nccl_hca=${NCCL_IB_HCA:-unset} nccl_debug=${NCCL_DEBUG:-unset}"
echo "[info] runtime nodes=${PRETRAIN_NODES} world=${PRETRAIN_WORLD_SIZE} gpu_ids=${PRETRAIN_GPU_IDS} batch=${PRETRAIN_BATCH_SIZE} batch_per_gpu=${PRETRAIN_BATCH_SIZE_PER_GPU}"
nvidia-smi -L 2>/dev/null | sed 's/^/[info] /' || true
python3 - <<'PY' 2>/dev/null || true
import torch
print(f"[info] torch={torch.__version__} cuda={torch.version.cuda} cudnn={torch.backends.cudnn.version()}")
PY

if (( PRETRAIN_NODES > 1 )); then
  export NERFMAE_DDP_USE_ENV="${NERFMAE_DDP_USE_ENV:-1}"
  export NERFMAE_DDP_NUM_NODES="${NERFMAE_DDP_NUM_NODES:-${PRETRAIN_NODES}}"
  export NERFMAE_DDP_WORLD_SIZE="${NERFMAE_DDP_WORLD_SIZE:-${PRETRAIN_WORLD_SIZE}}"
  export NERFMAE_DDP_MASTER_PORT="${NERFMAE_DDP_MASTER_PORT:-${PRETRAIN_MASTER_PORT}}"
fi

mkdir -p "${ROOT_DIR}/output/launcher" "${ROOT_DIR}/runtime"

stage_pretrain_data_if_requested() {
  if [[ "${STAGE_PRETRAIN_DATA}" != "1" ]]; then
    return 0
  fi

  local src stage_base dest partial marker available_gb source_gb required_gb min_required_gb
  local feature_count split_sig
  src="$(readlink -f "${PRETRAIN_DATA_SRC}")"
  if [[ ! -d "${src}/features" || ! -f "${src}/nerfmae_split.npz" ]]; then
    echo "[error] invalid PRETRAIN_DATA_SRC=${src}" >&2
    exit 1
  fi
  split_sig="$(cksum "${src}/nerfmae_split.npz" | awk '{ print $1 ":" $2 }')"

  stage_base="${LOCAL_STAGE_ROOT:-${PBS_LOCALDIR:-}}"
  if [[ -z "${stage_base}" ]]; then
    echo "[error] STAGE_PRETRAIN_DATA=1 requires LOCAL_STAGE_ROOT or PBS_LOCALDIR" >&2
    exit 1
  fi
  mkdir -p "${stage_base}"

  available_gb="$(df -BG --output=avail "${stage_base}" | tail -n 1 | tr -dc '0-9')"
  source_gb="$(du -sBG "${src}" | awk '{ gsub(/G/, "", $1); print $1 }')"
  required_gb=$((source_gb + 10))
  min_required_gb="${STAGE_MIN_FREE_GB}"
  if [[ "${required_gb}" -gt "${min_required_gb}" ]]; then
    min_required_gb="${required_gb}"
  fi
  if [[ -n "${available_gb}" && "${available_gb}" -lt "${min_required_gb}" ]]; then
    echo "[error] local stage root has ${available_gb}GB free, need >=${min_required_gb}GB: ${stage_base}" >&2
    exit 1
  fi

  dest="${stage_base}/nerfmae_data/pretrain"
  partial="${dest}.partial"
  marker="${dest}/.nerfmae_stage_done"
  if [[ -f "${marker}" && -d "${dest}/features" && -f "${dest}/nerfmae_split.npz" ]] \
      && grep -Fxq "source=${src}" "${marker}" \
      && grep -Fxq "split_cksum=${split_sig}" "${marker}"; then
    PRETRAIN_DATA_ROOT="${dest}"
    echo "[info] using existing staged pretrain data: ${PRETRAIN_DATA_ROOT}"
    return 0
  elif [[ -e "${dest}" ]]; then
    echo "[info] removing stale staged pretrain data: ${dest}"
  fi

  rm -rf "${partial}" "${dest}"
  mkdir -p "$(dirname "${dest}")"
  echo "[info] staging pretrain data src=${src} dest=${dest}"
  rsync -a --delete "${src}/" "${partial}/"
  test -f "${partial}/nerfmae_split.npz"
  test -d "${partial}/features"
  feature_count="$(find "${partial}/features" -maxdepth 1 -name '*.npz' | wc -l | tr -d '[:space:]')"
  if [[ "${feature_count}" -lt 3000 ]]; then
    echo "[error] staged feature count is unexpectedly low: ${feature_count}" >&2
    exit 1
  fi
  {
    echo "source=${src}"
    echo "split_cksum=${split_sig}"
    echo "source_gb=${source_gb}"
    echo "feature_count=${feature_count}"
  } > "${partial}/.nerfmae_stage_done"
  mv "${partial}" "${dest}"
  PRETRAIN_DATA_ROOT="${dest}"
  echo "[info] staged pretrain data ready root=${PRETRAIN_DATA_ROOT} features=${feature_count}"

  if [[ "${STAGE_KEEP}" != "1" ]]; then
    echo "[info] staged data is job-local and may be removed by PBS after completion"
  fi
}

stage_pretrain_data_if_requested

common_env=(
  DATA_ROOT="${PRETRAIN_DATA_ROOT}"
  DATASET_NAME=nerfmae
  SAVE_NAME="${SAVE_NAME}"
  RUN_TAG="${SAVE_NAME}"
  GPU_IDS="${PRETRAIN_GPU_IDS}"
  NUM_EPOCHS="${EPOCHS}"
  PERCENT_TRAIN=1.0
  BATCH_SIZE="${PRETRAIN_BATCH_SIZE}"
  BATCH_SIZE_PER_GPU="${PRETRAIN_BATCH_SIZE_PER_GPU}"
  LR="${PRETRAIN_LR}"
  WEIGHT_DECAY="${PRETRAIN_WEIGHT_DECAY}"
  LOG_INTERVAL="${PRETRAIN_LOG_INTERVAL}"
  EVAL_INTERVAL="${PRETRAIN_EVAL_INTERVAL}"
  CHECKPOINT_INTERVAL="${PRETRAIN_CHECKPOINT_INTERVAL}"
  KEEP_CHECKPOINTS="${PRETRAIN_KEEP_CHECKPOINTS}"
  PROFILE_STEP_TIME="${PRETRAIN_PROFILE_STEP_TIME}"
  TRAIN_NUM_WORKERS="${PRETRAIN_TRAIN_NUM_WORKERS}"
  EVAL_NUM_WORKERS="${PRETRAIN_EVAL_NUM_WORKERS}"
  PERSISTENT_WORKERS="${PRETRAIN_PERSISTENT_WORKERS}"
  USE_WANDB="${USE_WANDB}"
  WANDB_MODE="${WANDB_MODE}"
  SEED="${SEED}"
  DETERMINISTIC="${DETERMINISTIC}"
  DISABLE_ABS_POS_EMBED="${DISABLE_ABS_POS_EMBED}"
  DISABLE_RELATIVE_POSITION_BIAS="${DISABLE_RELATIVE_POSITION_BIAS}"
  ROTATE_PROB="${ROTATE_PROB}"
  FLIP_PROB="${FLIP_PROB}"
  ROT_SCALE_PROB="${ROT_SCALE_PROB}"
  COORD_SHIFT_PROB="${COORD_SHIFT_PROB}"
  COORD_SHIFT_MAX_VOXELS="${COORD_SHIFT_MAX_VOXELS}"
)

resume_env=()
if [[ "${AUTO_RESUME_PRETRAIN}" == "1" ]]; then
  resume_checkpoint="$(latest_epoch_checkpoint || true)"
  if [[ -n "${resume_checkpoint}" && "${resume_checkpoint}" != "${CHECKPOINT_PATH}" ]]; then
    echo "[info] auto-resume pretrain save=${SAVE_NAME} checkpoint=${resume_checkpoint}"
    resume_env=(
      RESUME_CHECKPOINT="${resume_checkpoint}"
      RESUME_ALLOW_PARTIAL="${RESUME_ALLOW_PARTIAL}"
    )
  fi
fi

cd "${ROOT_DIR}/nerf_mae"

case "${KIND}:${CONDITION}" in
  baseline:baseline)
    env "${common_env[@]}" "${resume_env[@]}" PROBE_MODE=baseline bash train_mae3d.sh
    ;;
  curriculum:cosine_ramp|curriculum:cosine_ramp_coord_jitter|curriculum:linear_ramp_coord_jitter|curriculum:step_ramp_coord_jitter|curriculum:reverse_ramp_coord_jitter|curriculum:constant_mixed_coord_jitter)
    curriculum_mode="cosine_rgb_ramp"
    curriculum_epochs="${EPOCHS}"
    rgb_start="0.0"
    rgb_end="1.0"
    rgb_weight="1.0"
    extra_env=()
    if [[ "${CONDITION}" == *_coord_jitter ]]; then
      extra_env=(
        ROTATE_PROB="${ROTATE_PROB:-1.0}"
        FLIP_PROB="${FLIP_PROB:-0.5}"
        ROT_SCALE_PROB="${ROT_SCALE_PROB:-0.0}"
        COORD_SHIFT_PROB="${COORD_SHIFT_PROB:-1.0}"
        COORD_SHIFT_MAX_VOXELS="${COORD_SHIFT_MAX_VOXELS:-8}"
      )
    fi
    case "${CONDITION}" in
      linear_ramp_coord_jitter)
        curriculum_mode="linear_rgb_ramp"
        ;;
      step_ramp_coord_jitter)
        curriculum_mode="alpha_warmup"
        curriculum_epochs="${PROBE_CURRICULUM_EPOCHS:-$(((EPOCHS + 1) / 2))}"
        ;;
      reverse_ramp_coord_jitter)
        curriculum_mode="cosine_rgb_ramp"
        rgb_start="1.0"
        rgb_end="0.0"
        ;;
      constant_mixed_coord_jitter)
        curriculum_mode="none"
        rgb_start="0.5"
        rgb_end="0.5"
        rgb_weight="0.5"
        ;;
    esac
    env "${common_env[@]}" "${resume_env[@]}" \
      "${extra_env[@]}" \
      PROBE_MODE=custom \
      PROBE_RGB_INPUT=keep \
      PROBE_ALPHA_INPUT=keep \
      PROBE_ALPHA_TARGET=keep \
      PROBE_RGB_LOSS=occupied \
      PROBE_ALPHA_LOSS=removed \
      PROBE_RGB_WEIGHT="${rgb_weight}" \
      PROBE_ALPHA_WEIGHT=1.0 \
      PROBE_CURRICULUM="${curriculum_mode}" \
      PROBE_CURRICULUM_EPOCHS="${curriculum_epochs}" \
      PROBE_CURRICULUM_RGB_START_WEIGHT="${rgb_start}" \
      PROBE_CURRICULUM_RGB_END_WEIGHT="${rgb_end}" \
      PROBE_CURRICULUM_ALPHA_WEIGHT=1.0 \
      bash train_mae3d.sh
    ;;
  curriculum:cosine_ramp_alpha_shuffle)
    env "${common_env[@]}" "${resume_env[@]}" \
      PROBE_MODE=custom \
      PROBE_RGB_INPUT=keep \
      PROBE_ALPHA_INPUT=keep \
      PROBE_ALPHA_TARGET=shuffle \
      PROBE_RGB_LOSS=occupied \
      PROBE_ALPHA_LOSS=removed \
      PROBE_RGB_WEIGHT=1.0 \
      PROBE_ALPHA_WEIGHT=1.0 \
      PROBE_CURRICULUM=cosine_rgb_ramp \
      PROBE_CURRICULUM_EPOCHS="${EPOCHS}" \
      PROBE_CURRICULUM_RGB_START_WEIGHT=0.0 \
      PROBE_CURRICULUM_RGB_END_WEIGHT=1.0 \
      PROBE_CURRICULUM_ALPHA_WEIGHT=1.0 \
      bash train_mae3d.sh
    ;;
  diagnostic:alpha_target_only|diagnostic:alpha_target_only_no_pos|diagnostic:alpha_target_only_coord_jitter)
    extra_env=()
    if [[ "${CONDITION}" == "alpha_target_only_no_pos" ]]; then
      extra_env=(DISABLE_ABS_POS_EMBED=1 DISABLE_RELATIVE_POSITION_BIAS=1)
    elif [[ "${CONDITION}" == "alpha_target_only_coord_jitter" ]]; then
      extra_env=(
        ROTATE_PROB="${ROTATE_PROB:-1.0}"
        FLIP_PROB="${FLIP_PROB:-0.5}"
        ROT_SCALE_PROB="${ROT_SCALE_PROB:-0.0}"
        COORD_SHIFT_PROB="${COORD_SHIFT_PROB:-1.0}"
        COORD_SHIFT_MAX_VOXELS="${COORD_SHIFT_MAX_VOXELS:-8}"
      )
    fi
    env "${common_env[@]}" "${resume_env[@]}" "${extra_env[@]}" \
      PROBE_MODE=custom \
      PROBE_RGB_INPUT=zero \
      PROBE_ALPHA_INPUT=zero \
      PROBE_ALPHA_TARGET=keep \
      PROBE_RGB_LOSS=none \
      PROBE_ALPHA_LOSS=removed \
      PROBE_RGB_WEIGHT=0.0 \
      PROBE_ALPHA_WEIGHT=1.0 \
      bash train_mae3d.sh
    ;;
  diagnostic:baseline_no_pos)
    env "${common_env[@]}" "${resume_env[@]}" \
      DISABLE_ABS_POS_EMBED=1 \
      DISABLE_RELATIVE_POSITION_BIAS=1 \
      PROBE_MODE=baseline \
      bash train_mae3d.sh
    ;;
  diagnostic:paper_loss)
    env "${common_env[@]}" "${resume_env[@]}" \
      PROBE_MODE=custom \
      PROBE_RGB_INPUT=keep \
      PROBE_ALPHA_INPUT=keep \
      PROBE_ALPHA_TARGET=keep \
      PROBE_RGB_LOSS=removed_occupied \
      PROBE_ALPHA_LOSS=removed \
      PROBE_RGB_WEIGHT=1.0 \
      PROBE_ALPHA_WEIGHT=1.0 \
      bash train_mae3d.sh
    ;;
  diagnostic:baseline_coord_jitter)
    env "${common_env[@]}" "${resume_env[@]}" \
      ROTATE_PROB="${ROTATE_PROB:-1.0}" \
      FLIP_PROB="${FLIP_PROB:-0.5}" \
      ROT_SCALE_PROB="${ROT_SCALE_PROB:-0.0}" \
      COORD_SHIFT_PROB="${COORD_SHIFT_PROB:-1.0}" \
      COORD_SHIFT_MAX_VOXELS="${COORD_SHIFT_MAX_VOXELS:-8}" \
      PROBE_MODE=baseline \
      bash train_mae3d.sh
    ;;
  diagnostic:cosine_no_pos|diagnostic:cosine_coord_jitter|diagnostic:shuffle_coord_jitter)
    extra_env=()
    if [[ "${CONDITION}" == "cosine_no_pos" ]]; then
      extra_env=(DISABLE_ABS_POS_EMBED=1 DISABLE_RELATIVE_POSITION_BIAS=1)
    elif [[ "${CONDITION}" == "cosine_coord_jitter" || "${CONDITION}" == "shuffle_coord_jitter" ]]; then
      extra_env=(
        ROTATE_PROB="${ROTATE_PROB:-1.0}"
        FLIP_PROB="${FLIP_PROB:-0.5}"
        ROT_SCALE_PROB="${ROT_SCALE_PROB:-0.0}"
        COORD_SHIFT_PROB="${COORD_SHIFT_PROB:-1.0}"
        COORD_SHIFT_MAX_VOXELS="${COORD_SHIFT_MAX_VOXELS:-8}"
      )
    fi
    env "${common_env[@]}" "${resume_env[@]}" "${extra_env[@]}" \
      PROBE_MODE=custom \
      PROBE_RGB_INPUT=keep \
      PROBE_ALPHA_INPUT=keep \
      PROBE_ALPHA_TARGET="$([[ "${CONDITION}" == "shuffle_coord_jitter" ]] && printf shuffle || printf keep)" \
      PROBE_RGB_LOSS=occupied \
      PROBE_ALPHA_LOSS=removed \
      PROBE_RGB_WEIGHT=1.0 \
      PROBE_ALPHA_WEIGHT=1.0 \
      PROBE_CURRICULUM=cosine_rgb_ramp \
      PROBE_CURRICULUM_EPOCHS="${EPOCHS}" \
      PROBE_CURRICULUM_RGB_START_WEIGHT=0.0 \
      PROBE_CURRICULUM_RGB_END_WEIGHT=1.0 \
      PROBE_CURRICULUM_ALPHA_WEIGHT=1.0 \
      bash train_mae3d.sh
    ;;
  diagnostic:dmae_target_alpha_gated_rgb|diagnostic:dmae_hier_concat|diagnostic:dmae_hier_concat_coord_jitter|diagnostic:dmae_hier_film)
    decomp_mode=""
    rgb_loss="occupied"
    extra_env=()
    case "${CONDITION}" in
      dmae_target_alpha_gated_rgb)
        decomp_mode="target_alpha_gated_rgb"
        rgb_loss="target_alpha"
        ;;
      dmae_hier_concat)
        decomp_mode="hierarchical_concat"
        ;;
      dmae_hier_concat_coord_jitter)
        decomp_mode="hierarchical_concat"
        extra_env=(
          ROTATE_PROB="${ROTATE_PROB:-1.0}"
          FLIP_PROB="${FLIP_PROB:-0.5}"
          ROT_SCALE_PROB="${ROT_SCALE_PROB:-0.0}"
          COORD_SHIFT_PROB="${COORD_SHIFT_PROB:-1.0}"
          COORD_SHIFT_MAX_VOXELS="${COORD_SHIFT_MAX_VOXELS:-8}"
        )
        ;;
      dmae_hier_film)
        decomp_mode="hierarchical_film"
        ;;
    esac
    env "${common_env[@]}" "${resume_env[@]}" "${extra_env[@]}" \
      PROBE_MODE=custom \
      PROBE_RGB_INPUT=keep \
      PROBE_ALPHA_INPUT=keep \
      PROBE_ALPHA_TARGET=keep \
      PROBE_RGB_LOSS="${rgb_loss}" \
      PROBE_ALPHA_LOSS=removed \
      PROBE_RGB_WEIGHT=1.0 \
      PROBE_ALPHA_WEIGHT=1.0 \
      PROBE_DECOMP_MODE="${decomp_mode}" \
      bash train_mae3d.sh
    ;;
  surface_maturation:surface_maturation_tau0p3_k10_w0p05|surface_maturation:surface_maturation_tau0p5_k20_w0p05|surface_maturation:surface_maturation_tau0p7_k30_w0p05|surface_maturation:surface_maturation_cosine_coord_jitter_tau0p7_k30_w0p05|surface_maturation:input_alpha_curriculum)
    sm_tau="${SM_TAU:-0.5}"
    sm_k="${SM_K:-20}"
    sm_w_min="${SM_W_MIN:-0.05}"
    sm_input_curriculum="${SM_INPUT_RGB_CURRICULUM:-none}"
    sm_input_start="${SM_INPUT_RGB_START:-0.0}"
    sm_input_end="${SM_INPUT_RGB_END:-1.0}"
    sm_input_epochs="${SM_INPUT_RGB_EPOCHS:-${EPOCHS}}"
    case "${CONDITION}" in
      surface_maturation_tau0p3_k10_w0p05)
        sm_tau="${SM_TAU:-0.3}"
        sm_k="${SM_K:-10}"
        sm_w_min="${SM_W_MIN:-0.05}"
        ;;
      surface_maturation_tau0p5_k20_w0p05)
        sm_tau="${SM_TAU:-0.5}"
        sm_k="${SM_K:-20}"
        sm_w_min="${SM_W_MIN:-0.05}"
        ;;
      surface_maturation_tau0p7_k30_w0p05)
        sm_tau="${SM_TAU:-0.7}"
        sm_k="${SM_K:-30}"
        sm_w_min="${SM_W_MIN:-0.05}"
        ;;
      surface_maturation_cosine_coord_jitter_tau0p7_k30_w0p05)
        sm_tau="${SM_TAU:-0.7}"
        sm_k="${SM_K:-30}"
        sm_w_min="${SM_W_MIN:-0.05}"
        ;;
      input_alpha_curriculum)
        sm_tau="${SM_TAU:-0.5}"
        sm_k="${SM_K:-20}"
        sm_w_min="${SM_W_MIN:-0.05}"
        sm_input_curriculum="${SM_INPUT_RGB_CURRICULUM:-cosine_release}"
        sm_input_start="${SM_INPUT_RGB_START:-0.0}"
        sm_input_end="${SM_INPUT_RGB_END:-1.0}"
        sm_input_epochs="${SM_INPUT_RGB_EPOCHS:-${EPOCHS}}"
        ;;
    esac
    env "${common_env[@]}" "${resume_env[@]}" \
      TRAIN_ENTRYPOINT=run_swin_surface_maturation.py \
      ROTATE_PROB="${ROTATE_PROB:-1.0}" \
      FLIP_PROB="${FLIP_PROB:-0.5}" \
      ROT_SCALE_PROB="${ROT_SCALE_PROB:-0.0}" \
      COORD_SHIFT_PROB="${COORD_SHIFT_PROB:-1.0}" \
      COORD_SHIFT_MAX_VOXELS="${COORD_SHIFT_MAX_VOXELS:-8}" \
      SM_MODE="${SM_MODE:-surface_maturation}" \
      SM_CONFIDENCE="${SM_CONFIDENCE:-raw_alpha}" \
      SM_W_MIN="${sm_w_min}" \
      SM_TAU="${sm_tau}" \
      SM_K="${sm_k}" \
      SM_STOP_GATE_GRAD="${SM_STOP_GATE_GRAD:-1}" \
      SM_RGB_MASK="${SM_RGB_MASK:-removed_occupied}" \
      SM_INPUT_RGB_CURRICULUM="${sm_input_curriculum}" \
      SM_INPUT_RGB_START="${sm_input_start}" \
      SM_INPUT_RGB_END="${sm_input_end}" \
      SM_INPUT_RGB_EPOCHS="${sm_input_epochs}" \
      SM_LOG_STATS="${SM_LOG_STATS:-1}" \
      PROBE_MODE=custom \
      PROBE_RGB_INPUT=keep \
      PROBE_ALPHA_INPUT=keep \
      PROBE_ALPHA_TARGET=keep \
      PROBE_RGB_LOSS=removed_occupied \
      PROBE_ALPHA_LOSS=removed \
      PROBE_RGB_WEIGHT=1.0 \
      PROBE_ALPHA_WEIGHT=1.0 \
      PROBE_CURRICULUM="$([[ "${CONDITION}" == "surface_maturation_cosine_coord_jitter_tau0p7_k30_w0p05" ]] && printf cosine_rgb_ramp || printf none)" \
      PROBE_CURRICULUM_EPOCHS="${EPOCHS}" \
      PROBE_CURRICULUM_RGB_START_WEIGHT="$([[ "${CONDITION}" == "surface_maturation_cosine_coord_jitter_tau0p7_k30_w0p05" ]] && printf 0.0 || printf 1.0)" \
      PROBE_CURRICULUM_RGB_END_WEIGHT=1.0 \
      PROBE_CURRICULUM_ALPHA_WEIGHT=1.0 \
      bash train_mae3d.sh
    ;;
  pyramid:pyramid_alpha|pyramid:pyramid_rgb|pyramid:pyramid_both)
    pyr_mode="${PYR_MODE:-both}"
    case "${CONDITION}" in
      pyramid_alpha)
        pyr_mode="${PYR_MODE:-alpha}"
        ;;
      pyramid_rgb)
        pyr_mode="${PYR_MODE:-rgb}"
        ;;
      pyramid_both)
        pyr_mode="${PYR_MODE:-both}"
        ;;
    esac
    env "${common_env[@]}" "${resume_env[@]}" \
      TRAIN_ENTRYPOINT=run_swin_pyramid_mae.py \
      ROTATE_PROB="${ROTATE_PROB:-1.0}" \
      FLIP_PROB="${FLIP_PROB:-0.5}" \
      ROT_SCALE_PROB="${ROT_SCALE_PROB:-0.0}" \
      COORD_SHIFT_PROB="${COORD_SHIFT_PROB:-1.0}" \
      COORD_SHIFT_MAX_VOXELS="${COORD_SHIFT_MAX_VOXELS:-8}" \
      PYR_MODE="${pyr_mode}" \
      PYR_SCALE="${PYR_SCALE:-2}" \
      PYR_SCHEDULE="${PYR_SCHEDULE:-cosine}" \
      PYR_EPOCHS="${PYR_EPOCHS:-${EPOCHS}}" \
      PYR_ALPHA_POOL="${PYR_ALPHA_POOL:-max}" \
      PYR_RGB_POOL="${PYR_RGB_POOL:-avg}" \
      PYR_UPSAMPLE="${PYR_UPSAMPLE:-trilinear}" \
      PYR_ALPHA_UPSAMPLE="${PYR_ALPHA_UPSAMPLE:-nearest}" \
      PYR_LOG_STATS="${PYR_LOG_STATS:-1}" \
      PROBE_MODE=custom \
      PROBE_RGB_INPUT=keep \
      PROBE_ALPHA_INPUT=keep \
      PROBE_ALPHA_TARGET=keep \
      PROBE_RGB_LOSS=occupied \
      PROBE_ALPHA_LOSS=removed \
      PROBE_RGB_WEIGHT=1.0 \
      PROBE_ALPHA_WEIGHT=1.0 \
      bash train_mae3d.sh
    ;;
  boundary_sdf:boundary_sdf_aux)
    env "${common_env[@]}" "${resume_env[@]}" \
      TRAIN_ENTRYPOINT=run_swin_boundary_sdf.py \
      BOUNDARY_SDF_MODE="${BOUNDARY_SDF_MODE:-sdf_aux}" \
      BOUNDARY_SDF_WEIGHT="${BOUNDARY_SDF_WEIGHT:-0.2}" \
      BOUNDARY_ALPHA_SMOOTH_SIGMA="${BOUNDARY_ALPHA_SMOOTH_SIGMA:-1.0}" \
      BOUNDARY_ALPHA_THRESHOLD="${BOUNDARY_ALPHA_THRESHOLD:-0.02}" \
      BOUNDARY_DISTANCE_CLIP="${BOUNDARY_DISTANCE_CLIP:-16}" \
      BOUNDARY_SDF_LOSS="${BOUNDARY_SDF_LOSS:-mse}" \
      BOUNDARY_SDF_MASK="${BOUNDARY_SDF_MASK:-removed}" \
      PROBE_MODE=custom \
      PROBE_RGB_INPUT=keep \
      PROBE_ALPHA_INPUT=keep \
      PROBE_ALPHA_TARGET=keep \
      PROBE_RGB_LOSS=occupied \
      PROBE_ALPHA_LOSS=removed \
      PROBE_RGB_WEIGHT=1.0 \
      PROBE_ALPHA_WEIGHT=1.0 \
      bash train_mae3d.sh
    ;;
  mixnerf:mixnerf_lite|mixnerf:mixnerf_lite_zeros|mixnerf:mixnerf_lite_noise|mixnerf:mixnerf_lite_shuffle|mixnerf:mixnerf_lite_shuffle_visible|mixnerf:mixnerf_lite_mean|mixnerf:mixnerf_lite_masked|mixnerf:mixnerf_lite_zeros_masked|mixnerf:mixnerf_lite_noise_masked|mixnerf:mixnerf_lite_shuffle_masked|mixnerf:mixnerf_lite_shuffle_visible_masked|mixnerf:mixnerf_lite_mean_masked)
    mix_fill="${MIXNERF_FILL_MODE:-partner}"
    mix_probe_mode="${MIXNERF_PROBE_MODE:-baseline}"
    mix_rgb_loss="${MIXNERF_PROBE_RGB_LOSS:-occupied}"
    mix_alpha_loss="${MIXNERF_PROBE_ALPHA_LOSS:-removed}"
    case "${CONDITION}" in
      mixnerf_lite|mixnerf_lite_masked)
        mix_fill="${MIXNERF_FILL_MODE:-partner}"
        ;;
      mixnerf_lite_zeros|mixnerf_lite_zeros_masked)
        mix_fill="${MIXNERF_FILL_MODE:-zeros}"
        ;;
      mixnerf_lite_noise|mixnerf_lite_noise_masked)
        mix_fill="${MIXNERF_FILL_MODE:-noise}"
        ;;
      mixnerf_lite_shuffle|mixnerf_lite_shuffle_masked)
        mix_fill="${MIXNERF_FILL_MODE:-shuffle}"
        ;;
      mixnerf_lite_shuffle_visible|mixnerf_lite_shuffle_visible_masked)
        mix_fill="${MIXNERF_FILL_MODE:-shuffle_visible}"
        ;;
      mixnerf_lite_mean|mixnerf_lite_mean_masked)
        mix_fill="${MIXNERF_FILL_MODE:-mean}"
        ;;
    esac
    case "${CONDITION}" in
      *_masked)
        mix_probe_mode="${MIXNERF_PROBE_MODE:-custom}"
        mix_rgb_loss="${MIXNERF_PROBE_RGB_LOSS:-removed_occupied}"
        mix_alpha_loss="${MIXNERF_PROBE_ALPHA_LOSS:-removed}"
        ;;
    esac
    env "${common_env[@]}" "${resume_env[@]}" \
      TRAIN_ENTRYPOINT=run_swin_mixnerf_mae.py \
      MIXNERF_MODE="${MIXNERF_MODE:-mix}" \
      MIXNERF_MASK_RATIO="${MIXNERF_MASK_RATIO:-0.75}" \
      MIXNERF_PARTNER="${MIXNERF_PARTNER:-roll}" \
      MIXNERF_FILL_MODE="${mix_fill}" \
      MIXNERF_PATCH_SIZE="${MIXNERF_PATCH_SIZE:-4}" \
      MIXNERF_DISABLE_INTERNAL_MASK="${MIXNERF_DISABLE_INTERNAL_MASK:-1}" \
      MIXNERF_LOG_STATS="${MIXNERF_LOG_STATS:-1}" \
      PROBE_MODE="${mix_probe_mode}" \
      PROBE_RGB_INPUT="${MIXNERF_PROBE_RGB_INPUT:-keep}" \
      PROBE_ALPHA_INPUT="${MIXNERF_PROBE_ALPHA_INPUT:-keep}" \
      PROBE_ALPHA_TARGET="${MIXNERF_PROBE_ALPHA_TARGET:-keep}" \
      PROBE_RGB_LOSS="${mix_rgb_loss}" \
      PROBE_ALPHA_LOSS="${mix_alpha_loss}" \
      PROBE_RGB_WEIGHT=1.0 \
      PROBE_ALPHA_WEIGHT=1.0 \
      bash train_mae3d.sh
    ;;
  visibility:visibility_feature_reset|visibility:visibility_skip_gate|visibility:visibility_reset_skip)
    vis_mode="${VISGATE_MODE:-skip_gate}"
    case "${CONDITION}" in
      visibility_feature_reset)
        vis_mode="${VISGATE_MODE:-feature_reset}"
        ;;
      visibility_skip_gate)
        vis_mode="${VISGATE_MODE:-skip_gate}"
        ;;
      visibility_reset_skip)
        vis_mode="${VISGATE_MODE:-reset_skip}"
        ;;
    esac
    env "${common_env[@]}" "${resume_env[@]}" \
      TRAIN_ENTRYPOINT=run_swin_visibility_gated.py \
      VISGATE_MODE="${vis_mode}" \
      VISGATE_RESET_STAGES="${VISGATE_RESET_STAGES:-0,1,2}" \
      VISGATE_SKIP_STAGES="${VISGATE_SKIP_STAGES:-0,1,2}" \
      VISGATE_LOG_STATS="${VISGATE_LOG_STATS:-1}" \
      PROBE_MODE=custom \
      PROBE_RGB_INPUT=keep \
      PROBE_ALPHA_INPUT=keep \
      PROBE_ALPHA_TARGET=keep \
      PROBE_RGB_LOSS=occupied \
      PROBE_ALPHA_LOSS=removed \
      PROBE_RGB_WEIGHT=1.0 \
      PROBE_ALPHA_WEIGHT=1.0 \
      PROBE_CURRICULUM=cosine_rgb_ramp \
      PROBE_CURRICULUM_EPOCHS="${EPOCHS}" \
      PROBE_CURRICULUM_RGB_START_WEIGHT=0.0 \
      PROBE_CURRICULUM_RGB_END_WEIGHT=1.0 \
      PROBE_CURRICULUM_ALPHA_WEIGHT=1.0 \
      bash train_mae3d.sh
    ;;
esac

test -f "${CHECKPOINT_PATH}"
echo "[info] pretrain complete checkpoint=${CHECKPOINT_PATH}"
