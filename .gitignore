*.npz
*.npz.*
*.npy
*.pt
*.pth
*.pkl
*.ckpt
*.safetensors
*.h5
*.hdf5

# --- Environments ---
.venv*/
.venv-abci3/

# --- Training / experiment outputs ---
output/
wandb/
runtime/

# Staged data partial copies (rsync staging)
*.partial/

# Legacy per-package output path (pre-ABCI3 local runs)
nerf_rpn/output/

# CUDA extension build artifacts (see nerf_rpn/build_rotated_iou.sh)
nerf_rpn/model/rotated_iou/cuda_op/build/

# --- PBS / cluster spillover (repo root when -o/-e not redirected) ---
*.e[0-9]*
*.o[0-9]*

# --- OS / editor ---
.DS_Store
.vscode/
*.swp
*~

# --- Python ---
**/__pycache__/
**/*.pyc
**/*.pyo
**/*.pyd
.pytest_cache/
.mypy_cache/
*.egg-info/

# --- Paper figure assets (figures_src/) ---
# Ignore intermediate/source assets; keep result-ready image dirs tracked.
figures_src/**/candidates/
figures_src/**/candidates_*/
figures_src/**/debug/
figures_src/**/nerf_rpn_front3d_nerf_data/
figures_src/**/front3d_render_data/
figures_src/**/scannet_render_data/

figures_src/**/*.jpg
figures_src/**/*.jpeg
figures_src/**/*.png
# Result-ready outputs (paper figures, shortlists, clear-win panels)
!figures_src/**/final/**/*.jpg
!figures_src/**/final/**/*.jpeg
!figures_src/**/final/**/*.png
!figures_src/**/final_*/**/*.jpg
!figures_src/**/final_*/**/*.jpeg
!figures_src/**/final_*/**/*.png
!figures_src/**/paper_shortlist_*/**/*.jpg
!figures_src/**/paper_shortlist_*/**/*.jpeg
!figures_src/**/paper_shortlist_*/**/*.png
!figures_src/**/readable_win_candidates/**/*.jpg
!figures_src/**/readable_win_candidates/**/*.jpeg
!figures_src/**/readable_win_candidates/**/*.png

figures_src/**/transforms.json
